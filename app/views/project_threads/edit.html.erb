<h1>Edit Thread</h1>
<%= form_with model: [@project, @thread], local: true do |f| %>
  <div><%= f.label :title %><br><%= f.text_field :title, required: true %></div>
  <div><%= f.label :body %><br><%= f.text_area :body %></div>
  <div><%= f.submit "Update Thread" %></div>
<% end %>
<%= link_to "Back", project_project_thread_path(@project, @thread) %>
