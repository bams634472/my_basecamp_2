<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "My Basecamp App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <header style="padding: 1rem; background: #f0f0f0; margin-bottom: 1rem;">
      <% if logged_in? %>
        Welcome, <strong><%= current_user.name %></strong> |
        <%= link_to "Projects", projects_path %> |
        <%= link_to "Logout", logout_path, method: :delete %>
      <% else %>
        <%= link_to "Sign Up", signup_path %> |
        <%= link_to "Login", login_path %>
      <% end %>
    </header>

    <% flash.each do |k, v| %>
      <div style="padding: 0.5rem; border: 1px solid #ddd; margin: 0.5rem 0; background: #fbfbfb;">
        <strong><%= k.capitalize %>:</strong> <%= v %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
